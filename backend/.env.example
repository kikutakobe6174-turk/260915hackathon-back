# SQLite DB file (relative to backend/ working directory)
DATABASE_URL=sqlite:///./data/app.db

# CORS: frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000

# Problem bank required-count multiplier (coverage calc)
REQUIRED_MULTIPLIER=3

# Review-candidate thresholds (problem bank flags)
LOW_ACCURACY_NO_HINT_THRESHOLD=0.4
HIGH_WRONG_AFTER_HINT3_THRESHOLD=0.2
